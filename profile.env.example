# swarm profile template — copy to <target>/.herdr-swarm/profile.env and edit.
# Rendered automatically by `lib/profile.sh ensure` (or `herdr-loop-swarm.sh
# up`); this file documents the keys for the hand-edit path. The file is
# gitignored per-target state — nothing here is committed.
#
# detect_ecosystem resolves: python | rust | node | go | make | run_all |
# generic. `make` requires a Makefile with a `test:` target; `run_all`
# requires run_all.sh; `generic` fails closed (no synthetic "true" gate).

# Canonical GitHub owner/repo (detect_repo prefers the `upstream` remote,
# then `origin`). "none" = local-only (suite-gated modes stay available;
# GitHub sync is not).
REPO="owner/repo"

# The Suite Gate command. Must be a real command: "", "none" and "true" are
# rejected by test_cmd_is_runnable and block gated modes — never fake-green.
TEST_CMD="make test"

ECOSYSTEM="make"
DOCS_DIR="docs"
